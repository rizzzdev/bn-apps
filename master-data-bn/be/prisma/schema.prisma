generator client {
  provider = "prisma-client-js"
  output   = "../src/database/generated"
}

datasource db {
  provider = "postgresql"
}

model sentri_identifiers {
  id           String       @id @db.VarChar(36)
  user_id      String       @db.VarChar(36)
  type         String       @db.VarChar(100)
  value        String       @unique @db.VarChar(255)
  created_at   DateTime     @default(now()) @db.Timestamp(6)
  sentri_users sentri_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_sentri_identifiers_user_id")
  @@unique([user_id, type])
}

model sentri_sessions {
  id           String       @id @db.VarChar(36)
  user_id      String       @db.VarChar(36)
  expires_at   DateTime     @db.Timestamp(6)
  ip_address   String?      @db.VarChar(45)
  user_agent   String?
  replaced_by  String?      @db.VarChar(36)
  created_at   DateTime     @default(now()) @db.Timestamp(6)
  sentri_users sentri_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_sentri_sessions_user_id")
}

model sentri_users {
  id                 String               @id @db.VarChar(36)
  password_hash      String               @db.VarChar(255)
  roles              String               @default("[]")
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  sentri_identifiers sentri_identifiers[]
  sentri_sessions    sentri_sessions[]
}

enum AcademicStatus {
  Aktif
  Tidak_Aktif @map("Tidak Aktif")
  Selesai
}

enum StudentStatus {
  Aktif
  Tidak_Aktif @map("Tidak Aktif")
  Lulus
}

enum TeacherStatus {
  Aktif
  Tidak_Aktif @map("Tidak Aktif")
  Pensiun
}

enum SemesterType {
  Ganjil
  Genap
}

enum Gender {
  L
  P
}

enum Religion {
  Islam
  Kristen
  Katolik
  Hindu
  Buddha
  Konghucu
}

model AcademicYear {
  id        String         @id @default(uuid())
  code      String
  startYear Int            @map("start_year")
  endYear   Int            @map("end_year")
  status    AcademicStatus @default(Tidak_Aktif)

  semesters Semester[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("academic_years")
}

model Semester {
  id     String         @id @default(uuid())
  type   SemesterType
  status AcademicStatus @default(Tidak_Aktif)

  academicYearId String       @map("academic_year_id")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("semesters")
}

model Major {
  id   String @id @default(uuid())
  code String
  name String

  classes         Class[]
  currentStudents Student[] @relation("MajorCurrentStudents")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("majors")
}

model Class {
  id   String @id @default(uuid())
  name String

  majorId         String    @map("major_id")
  major           Major     @relation(fields: [majorId], references: [id])
  currentStudents Student[] @relation("ClassCurrentStudents")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("classes")
}

model Teacher {
  id          String         @id @default(uuid())
  fullname    String
  nik         String?
  birthplace  String?
  birthdate   DateTime?
  gender      Gender?
  religion    Religion?
  ethnicGroup String?        @map("ethnic_group")
  status      TeacherStatus?
  prefixTitle String?        @map("prefix_title")
  suffixTitle String?        @map("suffix_title")
  nip         String?
  height      Int?
  weight      Int?
  phoneNumber String?        @map("phone_number")
  email       String?
  userId      String         @unique @map("user_id")

  pictureId String?     @unique @map("picture_id")
  picture   Attachment? @relation("TeacherPicture", fields: [pictureId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("teachers")
}

model Student {
  id          String         @id @default(uuid())
  fullname    String
  nik         String?
  birthplace  String?
  birthdate   DateTime?
  gender      Gender?
  religion    Religion?
  ethnicGroup String?        @map("ethnic_group")
  status      StudentStatus?
  nis         String?
  nisn        String?
  height      Int?
  weight      Int?
  phoneNumber String?        @map("phone_number")
  email       String?
  userId      String         @unique @map("user_id")

  currentClassId String? @map("current_class_id")
  currentClass   Class?  @relation("ClassCurrentStudents", fields: [currentClassId], references: [id])

  currentMajorId String? @map("current_major_id")
  currentMajor   Major?  @relation("MajorCurrentStudents", fields: [currentMajorId], references: [id])

  pictureId String?     @unique @map("picture_id")
  picture   Attachment? @relation("StudentPicture", fields: [pictureId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("students")
}

model Subject {
  id        String    @id @default(uuid())
  code      String
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("subjects")
}

model Attachment {
  id        String    @id @default(uuid())
  filename  String
  format    String
  size      Float
  url       String    @unique

  studentPicture Student? @relation("StudentPicture")
  teacherPicture Teacher? @relation("TeacherPicture")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("attachments")
}
