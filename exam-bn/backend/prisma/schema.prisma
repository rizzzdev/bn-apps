generator client {
  provider        = "prisma-client"
  output          = "../src/app/database/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPERVISOR
  PARTICIPANT
}

enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY
}

enum ExamRoomStatus {
  PENDING
  ONGOING
  ENDED
}

enum ParticipantSubmitStatus {
  NOT_SUBMITTED
  SUBMITTED
}

model User {
  id           String    @id @default(cuid()) @db.VarChar(25)
  fullname     String    @db.VarChar(255)
  username     String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash")
  role         UserRole
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  loginAudits      LoginAudit[]
  examParticipants ExamParticipant[]
  examSupervisors  ExamSupervisor[]
  examAnswers      ExamAnswer[]
  examScores       ExamScore[]
  examLogs         ExamLog[]
  essayGrades      EssayGrade[]
  sentChats        ExamChat[]        @relation("ChatSender")
  receivedChats    ExamChat[]        @relation("ChatReceiver")
  notifications    Notification[]
  createdExams     Exam[]            @relation("QuestionCreator")

  @@index([id], where: raw("deleted_at IS NULL"))
  @@map("user")
}

model LoginAudit {
  id        String    @id @default(cuid()) @db.VarChar(25)
  userId    String    @map("user_id") @db.VarChar(25)
  token     String
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent")
  loginAt   DateTime  @default(now()) @map("login_at") @db.Timestamptz()
  logoutAt  DateTime? @map("logout_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_audit")
}

model Room {
  id        String    @id @default(cuid()) @db.VarChar(25)
  name      String    @db.VarChar(255)
  capacity  Int?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  examRooms ExamRoom[]

  @@index([id], where: raw("deleted_at IS NULL"))
  @@map("room")
}

model Exam {
  id                String    @id @default(cuid()) @db.VarChar(25)
  questionCreatorId String?   @map("question_creator_id") @db.VarChar(25)
  name              String    @db.VarChar(255)
  description       String?
  startTime         DateTime  @map("start_time") @db.Timestamptz()
  endTime           DateTime  @map("end_time") @db.Timestamptz()
  mcWeight          Float?    @map("mc_weight")
  essayWeight       Float?    @map("essay_weight")
  passingGrade      Float     @default(75) @map("passing_grade")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz()

  examRooms       ExamRoom[]
  questionCreator User?      @relation("QuestionCreator", fields: [questionCreatorId], references: [id], onDelete: SetNull)

  @@index([id], where: raw("deleted_at IS NULL"))
  @@map("exam")
}

model ExamRoom {
  id          String          @id @default(cuid()) @db.VarChar(25)
  examId      String          @map("exam_id") @db.VarChar(25)
  roomId      String          @map("room_id") @db.VarChar(25)
  status      ExamRoomStatus  @default(PENDING)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz()

  exam             Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  room             Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  examParticipants ExamParticipant[]
  examSupervisors  ExamSupervisor[]
  examQuestions    ExamQuestion[]
  examAnswers      ExamAnswer[]
  examScores       ExamScore[]
  examLogs         ExamLog[]
  essayGrades      EssayGrade[]

  @@index([id], where: raw("deleted_at IS NULL"))
  @@map("exam_room")
}

model ExamLog {
  id         String   @id @default(cuid()) @db.VarChar(25)
  examRoomId String   @map("exam_room_id") @db.VarChar(25)
  userId     String?  @map("user_id") @db.VarChar(25)
  type       String   @db.VarChar(50)
  message    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  examRoom ExamRoom @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([examRoomId])
  @@map("exam_log")
}

model ExamChat {
  id         String   @id @default(cuid()) @db.VarChar(25)
  senderId   String   @map("sender_id") @db.VarChar(25)
  receiverId String   @map("receiver_id") @db.VarChar(25)
  message    String
  replyToId  String?  @map("reply_to_id") @db.VarChar(25)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  sender   User       @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User       @relation("ChatReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  replyTo  ExamChat?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies  ExamChat[] @relation("ChatReply")

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
  @@map("exam_chat")
}

model ExamParticipant {
  id          String                  @id @default(cuid()) @db.VarChar(25)
  examRoomId  String                  @map("exam_room_id") @db.VarChar(25)
  userId      String                  @map("user_id") @db.VarChar(25)
  status      ParticipantSubmitStatus @default(NOT_SUBMITTED)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz()

  examRoom ExamRoom @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examRoomId, userId])
  @@map("exam_participant")
}

model ExamSupervisor {
  id             String         @id @default(cuid()) @db.VarChar(25)
  examRoomId     String         @map("exam_room_id") @db.VarChar(25)
  userId         String         @map("user_id") @db.VarChar(25)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  examRoom ExamRoom @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examRoomId, userId])
  @@map("exam_supervisor")
}

model Question {
  id        String       @id @default(cuid()) @db.VarChar(25)
  text      String
  type      QuestionType
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz()

  options       Option[]
  correctAnswer QuestionCorrectAnswer?
  examQuestions ExamQuestion[]
  examAnswers   ExamAnswer[]
  essayGrades   EssayGrade[]

  @@index([id], where: raw("deleted_at IS NULL"))
  @@map("question")
}

model Option {
  id         String    @id @default(cuid()) @db.VarChar(25)
  questionId String    @map("question_id") @db.VarChar(25)
  text       String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz()

  question      Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  correctAnswer QuestionCorrectAnswer[]
  examAnswers   ExamAnswer[]

  @@index([id], where: raw("deleted_at IS NULL"))
  @@map("option")
}

model QuestionCorrectAnswer {
  id         String   @id @default(cuid()) @db.VarChar(25)
  questionId String   @unique @map("question_id") @db.VarChar(25)
  optionId   String   @map("option_id") @db.VarChar(25)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   Option   @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@map("question_correct_answer")
}

model ExamQuestion {
  id             String    @id @default(cuid()) @db.VarChar(25)
  examRoomId     String    @map("exam_room_id") @db.VarChar(25)
  questionId     String    @map("question_id") @db.VarChar(25)
  questionNumber Int       @map("question_number")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()

  examRoom ExamRoom @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([examRoomId, questionId])
  @@index([examRoomId, questionNumber], where: raw("deleted_at IS NULL"), map: "exam_question_room_number_active_uidx")
  @@index([id], where: raw("deleted_at IS NULL"))
  @@map("exam_question")
}

model ExamAnswer {
  id         String   @id @default(cuid()) @db.VarChar(25)
  examRoomId String   @map("exam_room_id") @db.VarChar(25)
  userId     String   @map("user_id") @db.VarChar(25)
  questionId String   @map("question_id") @db.VarChar(25)
  optionId   String?  @map("option_id") @db.VarChar(25)
  text       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  examRoom ExamRoom @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option   Option?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([examRoomId, userId, questionId])
  @@map("exam_answer")
}

model ExamScore {
  id         String   @id @default(cuid()) @db.VarChar(25)
  examRoomId String   @map("exam_room_id") @db.VarChar(25)
  userId     String   @map("user_id") @db.VarChar(25)
  score      Float?
  passed     Boolean? @map("passed")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  examRoom ExamRoom @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examRoomId, userId])
  @@map("exam_score")
}

model EssayGrade {
  id         String   @id @default(cuid()) @db.VarChar(25)
  examRoomId String   @map("exam_room_id") @db.VarChar(25)
  userId     String   @map("user_id") @db.VarChar(25)
  questionId String   @map("question_id") @db.VarChar(25)
  points     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  examRoom ExamRoom @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examRoomId, userId, questionId])
  @@map("essay_grade")
}

model Notification {
  id        String    @id @default(cuid()) @db.VarChar(25)
  userId    String    @map("user_id") @db.VarChar(25)
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(255)
  message   String
  meta      String?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], where: raw("deleted_at IS NULL"))
  @@map("notification")
}
