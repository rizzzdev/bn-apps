// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum SemesterType {
  Ganjil
  Genap
}

enum Gender {
  L
  P
}

enum ActiveStatus {
  Aktif
  TidakAktif @map("Tidak Aktif")
}

enum ClassStudentStatus {
  Aktif
  TidakAktif @map("Tidak Aktif")
  NaikKelas  @map("Naik Kelas")
  TinggalKelas @map("Tinggal Kelas")
  Pindah
  Lulus
}

enum MajorStudentStatus {
  Aktif
  TidakAktif @map("Tidak Aktif")
  Pindah
  Lulus
}

enum SubjectTeacherStatus {
  Aktif
  TidakAktif @map("Tidak Aktif")
  Lulus
}

model AcademicYear {
  id           String       @id @default(uuid())
  code         String
  semesterType SemesterType
  status       ActiveStatus @default(Aktif)

  majorStudents    MajorStudent[]
  classStudents    ClassStudent[]
  homeroomTeachers HomeroomTeacher[]
  majorHeads       MajorHead[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  lastSyncAt DateTime? @map("last_sync_at")

  @@map("shadow_academic_years")
}

model Major {
  id      String  @id @default(uuid())
  code    String
  name    String
  classes Class[]
  majorStudents MajorStudent[]
  majorHeads    MajorHead[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  lastSyncAt DateTime? @map("last_sync_at")

  @@map("shadow_majors")
}

model Class {
  id   String @id @default(uuid())
  name String

  majorId String @map("major_id")
  major   Major  @relation(fields: [majorId], references: [id])

  classStudents     ClassStudent[]
  homeroomTeachers  HomeroomTeacher[]
  lessonSchedules   LessonScheduleClass[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  lastSyncAt DateTime? @map("last_sync_at")

  @@map("shadow_classes")
}

model Teacher {
  id          String  @id @default(uuid())
  fullname    String
  prefixTitle String? @map("prefix_title")
  suffixTitle String? @map("suffix_title")
  gender      Gender?
  nip         String?
  email       String?
  userId      String  @unique @map("user_id")
  pictureUrl  String? @map("picture_url")
  status      String  @default("Aktif")

  homeroomTeachers   HomeroomTeacher[]
  subjectTeachers    SubjectTeacher[]
  picketSchedules    TeacherPicketSchedule[]
  majorHeads         MajorHead[]
  lessonSchedules    LessonScheduleTeacher[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  lastSyncAt DateTime? @map("last_sync_at")

  @@map("shadow_teachers")
}

model Student {
  id       String  @id @default(uuid())
  fullname String
  gender   Gender?
  nis      String?
  nisn     String?
  email    String?
  userId   String  @unique @map("user_id")
  pictureUrl String? @map("picture_url")
  status   String  @default("Aktif")

  majorStudents MajorStudent[]
  classStudents ClassStudent[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  lastSyncAt DateTime? @map("last_sync_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("shadow_students")
}

model LessonHour {
  id        String   @id @default(uuid())
  name      String   // "Jam ke-1", "Jam ke-2"
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  order     Int

  schedules LessonSchedule[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("lesson_hours")
}

model Subject {
  id         String    @id @default(uuid())
  code       String
  name       String
  subjectTeachers SubjectTeacher[]
  lessonSchedules LessonSchedule[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  lastSyncAt DateTime? @map("last_sync_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("shadow_subjects")
}

model MajorStudent {
  id            String             @id @default(uuid())
  majorId       String             @map("major_id")
  studentId     String             @map("student_id")
  academicYearId String            @map("academic_year_id")
  status        MajorStudentStatus

  major         Major              @relation(fields: [majorId], references: [id])
  student       Student            @relation(fields: [studentId], references: [id])
  academicYear  AcademicYear       @relation(fields: [academicYearId], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Partial unique index (student_id, academic_year_id) WHERE deleted_at IS NULL applied via raw SQL
  @@map("major_students")
}

model ClassStudent {
  id            String              @id @default(uuid())
  classId       String              @map("class_id")
  studentId     String              @map("student_id")
  academicYearId String             @map("academic_year_id")
  status        ClassStudentStatus

  class         Class               @relation(fields: [classId], references: [id])
  student       Student             @relation(fields: [studentId], references: [id])
  academicYear  AcademicYear        @relation(fields: [academicYearId], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Partial unique index (student_id, academic_year_id) WHERE deleted_at IS NULL applied via raw SQL
  @@map("class_students")
}

model HomeroomTeacher {
  id            String        @id @default(uuid())
  teacherId     String        @map("teacher_id")
  classId       String        @map("class_id")
  academicYearId String       @map("academic_year_id")
  status        ActiveStatus

  teacher       Teacher       @relation(fields: [teacherId], references: [id])
  class         Class         @relation(fields: [classId], references: [id])
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Partial unique index (teacher_id, class_id, academic_year_id) WHERE deleted_at IS NULL applied via raw SQL
  @@map("homeroom_teachers")
}

model MajorHead {
  id            String       @id @default(uuid())
  teacherId     String       @map("teacher_id")
  majorId       String       @map("major_id")
  academicYearId String      @map("academic_year_id")
  status        ActiveStatus

  teacher       Teacher      @relation(fields: [teacherId], references: [id])
  major         Major        @relation(fields: [majorId], references: [id])
  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Partial unique index (teacher_id, major_id, academic_year_id) WHERE deleted_at IS NULL applied via raw SQL
  @@map("major_heads")
}

model SubjectTeacher {
  id         String              @id @default(uuid())
  teacherId  String              @map("teacher_id")
  subjectId  String              @map("subject_id")
  status     SubjectTeacherStatus

  teacher    Teacher             @relation(fields: [teacherId], references: [id])
  subject    Subject             @relation(fields: [subjectId], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Partial unique index (teacher_id, subject_id) WHERE deleted_at IS NULL applied via raw SQL
  @@map("subject_teachers")
}

enum LessonScheduleStatus {
  Aktif
  TidakAktif @map("Tidak Aktif")
}

model LessonSchedule {
  id           String                @id @default(uuid())
  subjectId    String                @map("subject_id")
  lessonHourId String                @map("lesson_hour_id")
  day          String
  notes        String?
  status       LessonScheduleStatus  @default(Aktif)

  subject    Subject                 @relation(fields: [subjectId], references: [id])
  lessonHour LessonHour              @relation(fields: [lessonHourId], references: [id])
  teachers   LessonScheduleTeacher[]
  classes    LessonScheduleClass[]

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt      @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("lesson_schedules")
}

model LessonScheduleTeacher {
  id         String         @id @default(uuid())
  scheduleId String         @map("schedule_id")
  teacherId  String         @map("teacher_id")

  schedule   LessonSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  teacher    Teacher        @relation(fields: [teacherId], references: [id])

  createdAt  DateTime       @default(now()) @map("created_at")
  deletedAt  DateTime?      @map("deleted_at")

  @@map("lesson_schedule_teachers")
}

model LessonScheduleClass {
  id         String         @id @default(uuid())
  scheduleId String         @map("schedule_id")
  classId    String         @map("class_id")

  schedule   LessonSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  class      Class          @relation(fields: [classId], references: [id])

  createdAt  DateTime       @default(now()) @map("created_at")
  deletedAt  DateTime?      @map("deleted_at")

  @@map("lesson_schedule_classes")
}

model TeacherPicketSchedule {
  id        String       @id @default(uuid())
  teacherId String       @map("teacher_id")
  day       String
  status    ActiveStatus

  teacher   Teacher      @relation(fields: [teacherId], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Partial unique index (teacher_id, day) WHERE deleted_at IS NULL applied via raw SQL
  @@map("teacher_picket_schedules")
}
