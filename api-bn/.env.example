# -- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
CLIENT_URLS=http://localhost:5173,http://localhost:9093,http://localhost:9082,http://localhost:9072,http://localhost:9062,http://127.0.0.1:5173,http://127.0.0.1:9072,http://127.0.0.1:9062

# -- Database -----------------------------------------------------------------
DB_URL=postgresql://postgres:nightwitch96@localhost:5433

# -- Token --------------------------------------------------------------------
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# -- Security -----------------------------------------------------------------
SALT_ROUNDS=12
API_KEY=bn-secret-api-key
# -- Redis (optional) ---------------------------------------------------------
REDIS_URL=redis://localhost:6380

DOMAIN_NAME=localhost:5173

# -- Cookie -------------------------------------------------------------------
# Domain induk agar cookie auth (refresh_token/access_token) dibagikan ke semua
# subdomain (apps-bn.*, master-bn.*, dst). Kosongkan di development.
COOKIE_DOMAIN=
