{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "#app": ["./src/app/index.ts"],
      "#app/*": ["./src/app/*"],
      "#auth": ["./src/auth/index.ts"],
      "#auth/*": ["./src/auth/src/*"],
      "#master": ["./src/master/index.ts"],
      "#master/*": ["./src/master/src/*"],
      "#academic": ["./src/academic/index.ts"],
      "#academic/*": ["./src/academic/src/*"],
      "#learn": ["./src/learn/index.ts"],
      "#learn/*": ["./src/learn/src/*"],
      "#internship": ["./src/internship/index.ts"],
      "#internship/*": ["./src/internship/src/*"],
      "#exam": ["./src/exam/index.ts"],
      "#exam/*": ["./src/exam/src/*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true
  }
}
