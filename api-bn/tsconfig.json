{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@auth": ["./src/auth/index.ts"],
      "@auth/index.js": ["./src/auth/index.ts"],
      "@auth/*": ["./src/auth/src/*"],
      "@app": ["./src/app/index.ts"],
      "@app/index.js": ["./src/app/index.ts"],
      "@app/*": ["./src/app/*"],
      "@master": ["./src/master/index.ts"],
      "@master/index.js": ["./src/master/index.ts"],
      "@master/*": ["./src/master/src/*"],
      "@academic": ["./src/academic/index.ts"],
      "@academic/index.js": ["./src/academic/index.ts"],
      "@academic/*": ["./src/academic/src/*"],
      "@exam": ["./src/exam/index.ts"],
      "@exam/index.js": ["./src/exam/index.ts"],
      "@exam/*": ["./src/exam/src/*"],
      "@learn": ["./src/learn/index.ts"],
      "@learn/index.js": ["./src/learn/index.ts"],
      "@learn/*": ["./src/learn/*"],
      "@/*": ["./src/learn/*"],
      "@internship": ["./src/internship/index.ts"],
      "@internship/index.js": ["./src/internship/index.ts"],
      "@internship/*": ["./src/internship/src/*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true
  }
}
