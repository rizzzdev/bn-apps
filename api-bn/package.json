{
  "name": "api-bn",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "imports": {
    "#app": "./src/app/index.ts",
    "#app/*": "./src/app/*",
    "#auth": "./src/auth/index.ts",
    "#auth/*": "./src/auth/src/*",
    "#master": "./src/master/index.ts",
    "#master/*": "./src/master/src/*",
    "#academic": "./src/academic/index.ts",
    "#academic/*": "./src/academic/src/*",
    "#learn": "./src/learn/index.ts",
    "#learn/*": "./src/learn/*",
    "#/*": "./src/learn/*",
    "#internship": "./src/internship/index.ts",
    "#internship/*": "./src/internship/src/*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:migrate:master": "prisma migrate dev --config=src/master/prisma.config.ts",
    "db:migrate:academic": "prisma migrate dev --config=src/academic/prisma.config.ts",
    "db:migrate:internship": "prisma migrate dev --config=src/internship/prisma.config.ts",
    "db:migrate:learn": "prisma migrate dev --config=src/learn/prisma.config.ts",
    "db:migrate:auth": "prisma migrate dev --config=src/auth/prisma.config.ts",
    "db:migrate:deploy:master": "prisma migrate deploy --config=src/master/prisma.config.ts",
    "db:migrate:deploy:academic": "prisma migrate deploy --config=src/academic/prisma.config.ts",
    "db:migrate:deploy:internship": "prisma migrate deploy --config=src/internship/prisma.config.ts",
    "db:migrate:deploy:learn": "prisma migrate deploy --config=src/learn/prisma.config.ts",
    "db:migrate:deploy:auth": "prisma migrate deploy --config=src/auth/prisma.config.ts",
    "db:generate:master": "prisma generate --config=src/master/prisma.config.ts",
    "db:generate:academic": "prisma generate --config=src/academic/prisma.config.ts",
    "db:generate:internship": "prisma generate --config=src/internship/prisma.config.ts",
    "db:generate:learn": "prisma generate --config=src/learn/prisma.config.ts",
    "db:generate:auth": "prisma generate --config=src/auth/prisma.config.ts",
    "db:reset:master": "prisma migrate reset --config=src/master/prisma.config.ts",
    "db:reset:academic": "prisma migrate reset --config=src/academic/prisma.config.ts",
    "db:reset:internship": "prisma migrate reset --config=src/internship/prisma.config.ts",
    "db:reset:learn": "prisma migrate reset --config=src/learn/prisma.config.ts",
    "db:reset:auth": "prisma migrate reset --config=src/auth/prisma.config.ts",
    "db:pull:master": "prisma db pull --config=src/master/prisma.config.ts",
    "db:pull:academic": "prisma db pull --config=src/academic/prisma.config.ts",
    "db:pull:internship": "prisma db pull --config=src/internship/prisma.config.ts",
    "db:pull:learn": "prisma db pull --config=src/learn/prisma.config.ts",
    "db:pull:auth": "prisma db pull --config=src/auth/prisma.config.ts",
    "db:seed:academic": "tsx src/scripts/seed-lesson-hours.ts",
    "db:generate": "npm run db:generate:master && npm run db:generate:academic && npm run db:generate:internship && npm run db:generate:learn && npm run db:generate:auth",
    "build": "npm run db:generate",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "sentri": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}